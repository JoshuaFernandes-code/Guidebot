# GuideBot Environment Variables
STREAM_AUTH_TOKEN=guidebot_secret_token

# Set to true to always stream at VGA (640x480) even on a slow network.
# When false (default), the ESP32 auto-downgrades to QVGA if FPS drops.
FORCE_HIGH_RES=false

# Set to true to take audio and commands via Web UI at /audio over the tunnel URL.
# When true, the local PC microphone is completely disabled (avoids MME error spam).
# When false or unset (default), the /audio route returns 404 and web UI does not exist.
USE_WEB_MIC=false