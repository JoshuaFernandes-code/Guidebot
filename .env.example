# GuideBot — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to version control.

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong random token, e.g.: openssl rand -hex 16
STREAM_AUTH_TOKEN=change_me_to_a_strong_random_secret
# Optional LAN IPv4 advertised to the ESP32 for direct camera streaming.
# Leave blank to auto-detect the server's default-route address.
STREAM_LAN_HOST=

# ── Dashboard Authentication ─────────────────────────────────────────────────
# Allowed login emails are managed in the database via update_email.py:
#   python update_email.py add user@example.com
# Each email has its OWN password, set ONLY via:
#   python update_email.py set-password user@example.com

# ── Resolution ────────────────────────────────────────────────────────────────
# false (default): ESP32 always streams VGA (640×480) — best detection quality.
# true: ESP32 may auto-downgrade to QVGA (320×240) on slow networks.
ALLOW_LOW_RES=false

# ── Microphone ────────────────────────────────────────────────────────────────
# Use browser mic via Web UI at /audio (disables local PC mic when true).
USE_WEB_MIC=false

# Use ESP32-S3 Sense onboard I2S mic (streamed over the camera WebSocket).
USE_ESP32_MIC=false

ESP32_MIC_SAMPLE_RATE=16000
ESP32_MIC_VAD_THRESHOLD=0.015

# ── Whisper ASR ───────────────────────────────────────────────────────────────
# Options: tiny.en, base.en (recommended), small.en, medium.en
WHISPER_MODEL=base.en

# ── LLM Assistant (Ollama) ────────────────────────────────────────────────────
# false (default): LLM completely off — GuideBot uses rule-based responses only.
# true: conversational queries routed to local Ollama (must be installed).
LLM_ENABLED=true
LLM_AUTO_START=true
LLM_MODEL=llama3.2:1b
LLM_URL=http://127.0.0.1:11434
LLM_TIMEOUT=25.0

# Local vision scene description (requires: ollama pull qwen3-vl:4b-instruct)
VISION_ENABLED=true
VISION_MODEL=qwen3-vl:4b-instruct
VISION_TIMEOUT=240
VISION_FRAME_DIR=logs/vision-frames
VISION_FRAME_LIMIT=25
VISION_IMAGE_MAX_WIDTH=512
